{
	"name": "big-pharma-group",
	"description": "Big Pharma Group pharmacy website (Astro on Cloudflare Workers + D1)",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"astro": "astro",
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro build && wrangler dev",
		"check": "astro build && tsc --noEmit && wrangler deploy --dry-run",
		"deploy": "astro build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"db:local": "wrangler d1 execute big-pharma-db --local --file=migrations/0001_init.sql",
		"db:remote": "wrangler d1 execute big-pharma-db --remote --file=migrations/0001_init.sql"
	},
	"dependencies": {
		"@astrojs/cloudflare": "12.6.12",
		"astro": "5.16.9",
		"typescript": "5.9.3"
	},
	"devDependencies": {
		"wrangler": "4.136.1"
	}
}
