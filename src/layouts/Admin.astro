---
import "../styles/global.css";

interface Props {
	title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;
const nav = [
	{ href: "/admin", label: "Dashboard", th: "ภาพรวม" },
	{ href: "/admin/products", label: "Products", th: "สินค้า" },
	{ href: "/admin/import", label: "Import / Export", th: "นำเข้า / ส่งออก" },
	{ href: "/admin/orders", label: "Orders", th: "คำสั่งซื้อ" },
	{ href: "/admin/customers", label: "Customers", th: "ลูกค้า" },
	{ href: "/admin/settings", label: "Settings", th: "ตั้งค่า" },
];
const isOn = (href: string) => (href === "/admin" ? path === "/admin" || path === "/admin/" : path.startsWith(href));
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="robots" content="noindex,nofollow" />
		<title>{title} · Admin · Big Pharma Group</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet" />
	</head>
	<body class="admin">
		<header class="abar">
			<a href="/admin" class="abrand">Big Pharma <span>Admin</span></a>
			<nav class="anav">
				{
					nav.map((n) => (
						<a href={n.href} class:list={{ on: isOn(n.href) }}>
							{n.label}
							<small>{n.th}</small>
						</a>
					))
				}
			</nav>
			<div class="aright">
				<a href="/" target="_blank" class="small">View site ↗</a>
				<form method="post" action="/admin/logout"><button class="btn btn-ghost btn-sm">Log out</button></form>
			</div>
		</header>
		<main class="amain">
			<h1>{title}</h1>
			<slot />
		</main>
		<style is:global>
			body.admin {
				background: #f4f6f5;
			}
			.abar {
				background: #0f2a24;
				color: #fff;
				display: flex;
				align-items: center;
				gap: 18px;
				padding: 0 16px;
				min-height: 58px;
				flex-wrap: wrap;
				position: sticky;
				top: 0;
				z-index: 20;
			}
			.abrand {
				color: #fff;
				font-weight: 700;
				text-decoration: none;
			}
			.abrand span {
				color: #8fd3b9;
				font-weight: 500;
			}
			.anav {
				display: flex;
				gap: 2px;
				overflow-x: auto;
				flex: 1;
			}
			.anav a {
				color: #cfe3dc;
				text-decoration: none;
				padding: 8px 12px;
				border-radius: 8px;
				font-size: 0.9rem;
				line-height: 1.15;
				white-space: nowrap;
			}
			.anav a small {
				display: block;
				font-size: 0.7rem;
				opacity: 0.7;
			}
			.anav a.on,
			.anav a:hover {
				background: #1d4038;
				color: #fff;
			}
			.aright {
				display: flex;
				align-items: center;
				gap: 12px;
			}
			.aright a {
				color: #cfe3dc;
			}
			.aright .btn-ghost {
				color: #fff;
				border-color: #2d5148;
			}
			.amain {
				max-width: 1400px;
				margin: 0 auto;
				padding: 24px 16px 60px;
			}
			.amain > h1 {
				font-size: 1.5rem;
			}
			.toolbar {
				display: flex;
				gap: 10px;
				flex-wrap: wrap;
				align-items: flex-end;
				margin-bottom: 14px;
			}
			.toolbar .field {
				margin: 0;
			}
			.toolbar input,
			.toolbar select {
				min-height: 38px;
				padding: 6px 10px;
			}
			.kpis {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
				gap: 12px;
				margin-bottom: 20px;
			}
			.kpi {
				background: #fff;
				border: 1px solid var(--line);
				border-radius: var(--radius);
				padding: 16px;
				text-decoration: none;
				color: var(--ink);
			}
			.kpi b {
				display: block;
				font-size: 1.6rem;
			}
			.admin .card {
				margin-bottom: 16px;
			}
			.admin .table td input,
			.admin .table td select {
				min-height: 34px;
				padding: 4px 8px;
			}
		</style>
	</body>
</html>
