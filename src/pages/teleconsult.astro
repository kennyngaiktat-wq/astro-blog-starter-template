---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { run } from "../lib/db";
import { str } from "../lib/forms";

const { lang, user, settings, env } = Astro.locals;
const th = lang === "th";
const preset = (Astro.url.searchParams.get("symptom") ?? "").slice(0, 100);
let sent = false;
let error = "";
const v: Record<string, string> = { name: user?.name ?? "", phone: user?.phone ?? "", symptoms: preset ? `${preset}: ` : "", channel: "line" };

if (Astro.request.method === "POST") {
	const fd = await Astro.request.formData();
	for (const k of ["name", "phone", "line_id", "channel", "preferred_time", "age", "allergies", "current_meds"]) v[k] = str(fd, k, 200);
	v.symptoms = String(fd.get("symptoms") ?? "").trim().slice(0, 2000);
	if (String(fd.get("website") ?? "")) {
		sent = true; // honeypot: silently ignore bots
	} else if (!v.name || !v.phone || !v.symptoms) {
		error = th ? "กรุณากรอกชื่อ เบอร์โทร และอาการ" : "Please fill in your name, phone and symptoms";
	} else if (fd.get("consent") !== "on") {
		error = th ? "กรุณายินยอมให้เภสัชกรใช้ข้อมูลสุขภาพของคุณเพื่อให้คำปรึกษา" : "Please agree to let our pharmacist use your health information for the consultation";
	} else {
		await run(
			env.DB,
			`INSERT INTO consult_requests (customer_id, name, phone, line_id, channel, preferred_time, symptoms, age, allergies, current_meds)
			 VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
			user?.id ?? null,
			v.name,
			v.phone,
			v.line_id || null,
			["line", "phone", "video"].includes(v.channel) ? v.channel : "line",
			v.preferred_time || null,
			v.symptoms,
			v.age || null,
			v.allergies || null,
			v.current_meds || null,
		);
		sent = true;
	}
}
const steps = th
	? [
			{ icon: "chat", t: "เล่าอาการ", d: "กรอกแบบฟอร์มสั้นๆ หรือทักหาเราทาง LINE" },
			{ icon: "phone", t: "คุยกับเภสัชกร", d: "เภสัชกรติดต่อกลับทาง LINE โทรศัพท์ หรือวิดีโอคอล ในเวลาทำการ" },
			{ icon: "truck", t: "รับยา", d: "จัดส่งถึงบ้าน หรือแวะรับที่ร้าน" },
		]
	: [
			{ icon: "chat", t: "Tell us your symptoms", d: "Fill in the short form or message us on LINE" },
			{ icon: "phone", t: "Talk to a pharmacist", d: "We call back on LINE, phone or video during opening hours" },
			{ icon: "truck", t: "Get your medicine", d: "Delivered to your home, or pick up in store" },
		];
---

<Base title={th ? "ปรึกษาเภสัชกรออนไลน์" : "Online pharmacist consultation"} description={th ? "ปรึกษาเภสัชกรออนไลน์ฟรี ผ่าน LINE โทรศัพท์ หรือวิดีโอคอล" : "Free online consultation with our pharmacists on LINE, phone or video"}>
	<section class="tc-hero">
		<div class="wrap tc-grid">
			<div>
				<h1>{th ? "ปรึกษาเภสัชกรออนไลน์ ฟรี" : "Free online pharmacist consultation"}</h1>
				<p class="lead">{th ? "ไม่ต้องเดินทาง ไม่ต้องรอคิว เภสัชกรของเราพร้อมช่วยเลือกยาที่เหมาะกับอาการของคุณ" : "No travel, no queue. Our pharmacists help you choose the right medicine for your symptoms."}</p>
				<div class="cta">
					{settings.line_url && <a class="btn btn-line" href={settings.line_url} target="_blank" rel="noopener"><img src="/social/line-white.svg" alt="" width="18" height="18" /> {th ? "แชทกับเภสัชกรทาง LINE ตอนนี้" : "Chat on LINE now"}</a>}
					<a class="btn btn-ghost" href={`tel:${settings.phone.replace(/[^0-9+]/g, "")}`}><Icon name="phone" size={18} /> {settings.phone}</a>
				</div>
				<p class="small">{th ? settings.hours_th : settings.hours_en}</p>
			</div>
			<img src="/pharmacist.svg" alt="" width="260" height="285" class="ph" />
		</div>
	</section>

	<div class="wrap">
		<ol class="steps">
			{
				steps.map((s, i) => (
					<li class="card">
						<span class="num">{i + 1}</span>
						<Icon name={s.icon} size={26} />
						<strong>{s.t}</strong>
						<span class="small muted">{s.d}</span>
					</li>
				))
			}
		</ol>

		<div class="form-wrap">
			<section class="card">
				{
					sent ? (
						<div class="done">
							<h2>{th ? "ได้รับข้อมูลแล้ว ขอบคุณค่ะ" : "Thank you — we've got your request"}</h2>
							<p>{th ? "เภสัชกรจะติดต่อกลับโดยเร็วที่สุดในเวลาทำการ หากต้องการคุยทันที ทักหาเราทาง LINE ได้เลย" : "A pharmacist will contact you as soon as possible during opening hours. To talk straight away, message us on LINE."}</p>
							{settings.line_url && <a class="btn btn-line" href={settings.line_url} target="_blank" rel="noopener"><img src="/social/line-white.svg" alt="" width="18" height="18" /> LINE</a>}
						</div>
					) : (
						<form method="post">
							<h2 class="h3">{th ? "นัดปรึกษาเภสัชกร" : "Request a consultation"}</h2>
							{error && <div class="alert alert-error">{error}</div>}
							<div class="hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>
							<div class="grid-2">
								<div class="field"><label for="name">{th ? "ชื่อ" : "Name"} *</label><input id="name" name="name" required value={v.name} autocomplete="name" /></div>
								<div class="field"><label for="phone">{th ? "เบอร์โทร" : "Phone"} *</label><input id="phone" name="phone" type="tel" required value={v.phone} autocomplete="tel" /></div>
								<div class="field"><label for="line_id">LINE ID</label><input id="line_id" name="line_id" value={v.line_id ?? ""} /></div>
								<div class="field">
									<label for="channel">{th ? "ช่องทางที่สะดวก" : "Preferred channel"}</label>
									<select id="channel" name="channel">
										<option value="line" selected={v.channel === "line"}>LINE</option>
										<option value="phone" selected={v.channel === "phone"}>{th ? "โทรศัพท์" : "Phone call"}</option>
										<option value="video" selected={v.channel === "video"}>{th ? "วิดีโอคอล" : "Video call"}</option>
									</select>
								</div>
							</div>
							<div class="field"><label for="symptoms">{th ? "อาการที่เป็น และเป็นมานานเท่าไร" : "Your symptoms, and how long you've had them"} *</label><textarea id="symptoms" name="symptoms" required rows="4">{v.symptoms}</textarea></div>
							<div class="grid-2">
								<div class="field"><label for="age">{th ? "อายุ (ของผู้ป่วย)" : "Patient's age"}</label><input id="age" name="age" value={v.age ?? ""} /></div>
								<div class="field"><label for="preferred_time">{th ? "เวลาที่สะดวกให้ติดต่อ" : "Best time to contact you"}</label><input id="preferred_time" name="preferred_time" value={v.preferred_time ?? ""} placeholder={th ? "เช่น วันนี้ 18:00" : "e.g. today 6 pm"} /></div>
								<div class="field"><label for="allergies">{th ? "ประวัติแพ้ยา" : "Drug allergies"}</label><input id="allergies" name="allergies" value={v.allergies ?? ""} /></div>
								<div class="field"><label for="current_meds">{th ? "ยา/โรคประจำตัว" : "Current medicines / conditions"}</label><input id="current_meds" name="current_meds" value={v.current_meds ?? ""} /></div>
							</div>
							<label class="check small field"><input type="checkbox" name="consent" required /> <span>{th ? "ข้าพเจ้ายินยอมให้เภสัชกรของร้านใช้ข้อมูลสุขภาพข้างต้นเพื่อให้คำปรึกษาเท่านั้น" : "I agree that the shop's pharmacists may use the health information above for this consultation only"} (<a href="/privacy" target="_blank">{th ? "นโยบายความเป็นส่วนตัว" : "privacy policy"}</a>)</span></label>
							<button class="btn btn-block" type="submit">{th ? "ส่งข้อมูลให้เภสัชกร" : "Send to our pharmacist"}</button>
						</form>
					)
				}
			</section>
			<aside class="card emergency">
				<h2 class="h3">{th ? "อาการฉุกเฉิน?" : "Is it an emergency?"}</h2>
				<p class="small">{th ? "หากมีอาการรุนแรง เช่น เจ็บหน้าอก หายใจลำบาก หมดสติ แพ้ยารุนแรง โทร 1669 หรือไปโรงพยาบาลที่ใกล้ที่สุดทันที" : "For severe symptoms such as chest pain, difficulty breathing, fainting or a severe allergic reaction, call 1669 or go to the nearest hospital now."}</p>
				<a class="btn btn-danger btn-sm" href="tel:1669">{th ? "โทร 1669" : "Call 1669"}</a>
				<hr />
				<p class="small muted">{th ? "การปรึกษาออนไลน์ไม่ใช่การวินิจฉัยโรคโดยแพทย์ เภสัชกรจะแนะนำให้พบแพทย์เมื่อจำเป็น" : "An online consultation is not a doctor's diagnosis. Our pharmacist will advise you to see a doctor when needed."}</p>
			</aside>
		</div>
	</div>
</Base>

<style>
	.tc-hero {
		background: linear-gradient(160deg, #4fcca4, #c4f0df);
		color: #08372b;
		padding: 34px 0 10px;
	}
	.tc-grid {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 20px;
	}
	.lead {
		font-size: 1.05rem;
		max-width: 56ch;
	}
	.cta {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
		margin: 16px 0 10px;
	}
	.cta .btn-ghost {
		background: #fff;
		border-color: #fff;
	}
	.ph {
		width: 230px;
		height: auto;
		flex: none;
	}
	@media (max-width: 700px) {
		.ph {
			display: none;
		}
	}
	.steps {
		list-style: none;
		padding: 0;
		margin: 26px 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 14px;
	}
	.steps li {
		display: flex;
		flex-direction: column;
		gap: 6px;
		position: relative;
		color: var(--brand);
	}
	.steps strong {
		color: var(--ink);
	}
	.num {
		position: absolute;
		top: 14px;
		right: 16px;
		font-size: 1.8rem;
		font-weight: 700;
		color: #c4f0df;
	}
	@media (max-width: 700px) {
		.steps {
			grid-template-columns: 1fr;
		}
	}
	.form-wrap {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
		gap: 18px;
		align-items: start;
	}
	@media (max-width: 860px) {
		.form-wrap {
			grid-template-columns: 1fr;
		}
	}
	.hp {
		position: absolute;
		left: -9999px;
	}
	.emergency {
		border-color: #f3c6c1;
		background: #fff7f6;
	}
	.done {
		text-align: center;
		padding: 20px;
	}
	hr {
		border: 0;
		border-top: 1px solid var(--line);
		margin: 16px 0;
	}
</style>
