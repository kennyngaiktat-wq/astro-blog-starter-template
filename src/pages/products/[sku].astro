---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import ProductCard from "../../components/ProductCard.astro";
import { CATEGORIES, baht, canBuyOnline, displayName, splitTags, tagLabel, type Product } from "../../lib/catalog";
import { all, first } from "../../lib/db";
import { t } from "../../lib/i18n";

const { lang, user, settings, env } = Astro.locals;
const sku = decodeURIComponent(Astro.params.sku ?? "");
const p = await first<Product>(env.DB, "SELECT * FROM products WHERE sku = ? AND active = 1", sku);
if (!p) {
	return Astro.rewrite("/404");
}
const cat = CATEGORIES.find((c) => c.slug === p.category);
const buyable = canBuyOnline(p);
const out = p.stock <= 0;
const pct = Number(settings.member_discount_pct) || 0;
const memberPrice = Math.round(p.price_satang * (1 - pct / 100));
const related = await all<Product>(
	env.DB,
	"SELECT * FROM products WHERE active = 1 AND category = ? AND id != ? ORDER BY (stock > 0) DESC, RANDOM() LIMIT 4",
	p.category,
	p.id,
);
const tel = `tel:${settings.phone.replace(/[^0-9+]/g, "")}`;
const name = displayName(p, lang);
---

<Base title={name} description={p.description ?? `${name} — ${cat ? cat[lang] : ""}`}>
	<div class="wrap">
		<nav class="crumbs small">
			<a href="/products">{t(lang, "products")}</a> /
			{cat && <a href={`/products?category=${cat.slug}`}>{cat[lang]}</a>}
		</nav>
		<div class="pd" style={`--c: var(--cat-${p.category}); --cs: var(--cat-${p.category}-soft)`}>
			<div class="pd-img">
				{
					p.image_url ? (
						<img src={p.image_url} alt={name} />
					) : (
						<div class="pd-ph">
							<Icon name={cat?.icon ?? "otc"} size={84} />
						</div>
					)
				}
			</div>
			<div class="pd-info">
				<div class="pd-badges">
					{cat && <span class="badge" style="background: var(--cs); color: var(--c)">{cat[lang]}</span>}
					{!buyable && <span class="badge badge-consult">{t(lang, "consultBadge")}</span>}
					{buyable && (out ? <span class="badge badge-out">{t(lang, "outOfStock")}</span> : <span class="badge">{t(lang, "inStock")}</span>)}
				</div>
				<h1>{name}</h1>
				{lang === "en" && p.name_en && p.name !== p.name_en && <p class="muted">{p.name}</p>}
				<p class="muted small">
					{t(lang, "sku")}: {p.sku}
					{p.unit && <> · {t(lang, "unit")}: {p.unit}</>}
				</p>

				{
					buyable ? (
						<div class="pd-buy">
							<div class="pd-price">
								{user && pct > 0 ? (
									<>
										<strong>{baht(memberPrice)}</strong>
										<s class="muted">{baht(p.price_satang)}</s>
										<span class="badge">{t(lang, "memberActive", { pct })}</span>
									</>
								) : (
									<>
										<strong>{baht(p.price_satang)}</strong>
										{pct > 0 && (
											<a class="member small" href="/account/register">
												{t(lang, "memberPrice")} {baht(memberPrice)} — {t(lang, "register")}
											</a>
										)}
									</>
								)}
							</div>
							{out ? (
								<div class="pd-actions">
									{settings.line_url && (
										<a class="btn btn-line" href={settings.line_url} target="_blank" rel="noopener">
											<Icon name="chat" size={18} /> {t(lang, "askAvailability")}
										</a>
									)}
									<a class="btn btn-ghost" href={tel}>
										<Icon name="phone" size={18} /> {settings.phone}
									</a>
								</div>
							) : (
								<div class="pd-actions">
									<label class="qty">
										<span class="sr-only">{t(lang, "qty")}</span>
										<input id="qty" type="number" min="1" max="99" value="1" inputmode="numeric" />
									</label>
									<button class="btn" data-add-sku={p.sku} data-qty-from="#qty" data-added-label={t(lang, "added")}>
										<Icon name="cart" size={18} /> {t(lang, "addToCart")}
									</button>
									<a class="btn btn-ghost" href="/cart">
										{t(lang, "cart")}
									</a>
								</div>
							)}
						</div>
					) : (
						<div class="consult-box">
							<p>{t(lang, "consultNote")}</p>
							<div class="pd-actions">
								{settings.line_url && (
									<a class="btn btn-line" href={settings.line_url} target="_blank" rel="noopener">
										<Icon name="chat" size={18} /> {t(lang, "consultPharmacist")}
									</a>
								)}
								<a class="btn btn-ghost" href={tel}>
									<Icon name="phone" size={18} /> {settings.phone}
								</a>
								<a class="btn btn-ghost" href="/contact">
									<Icon name="map" size={18} /> {t(lang, "findUs")}
								</a>
							</div>
						</div>
					)
				}

				{
					p.description && (
						<div class="pd-desc">
							<h2 class="h3">{t(lang, "details")}</h2>
							<p>{p.description}</p>
						</div>
					)
				}
				{
					splitTags(p.tags).length > 0 && (
						<div class="pd-tags">
							{splitTags(p.tags).map((tg) => (
								<a class="chip" href={`/products?tag=${tg}`}>
									{tagLabel(tg, lang)}
								</a>
							))}
						</div>
					)
				}
			</div>
		</div>

		{
			related.length > 0 && (
				<section class="related">
					<h2>{t(lang, "related")}</h2>
					<div class="grid-products">
						{related.map((r) => (
							<ProductCard product={r} />
						))}
					</div>
				</section>
			)
		}
	</div>
</Base>

<style>
	.crumbs {
		padding: 18px 0 6px;
		color: var(--muted);
	}
	.crumbs a {
		color: var(--muted);
	}
	.pd {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
		gap: 36px;
		margin-top: 8px;
	}
	@media (max-width: 760px) {
		.pd {
			grid-template-columns: 1fr;
			gap: 18px;
		}
	}
	.pd-img {
		border-radius: 20px;
		overflow: hidden;
		border: 1px solid var(--line);
		background: #fff;
		aspect-ratio: 1;
	}
	.pd-img img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
	.pd-ph {
		height: 100%;
		display: grid;
		place-items: center;
		background: var(--cs);
		color: var(--c);
	}
	@media (max-width: 760px) {
		.pd-img {
			aspect-ratio: 16 / 9;
		}
	}
	.pd-badges {
		display: flex;
		gap: 6px;
		flex-wrap: wrap;
		margin-bottom: 10px;
	}
	.pd-info h1 {
		font-size: clamp(1.4rem, 3vw, 2rem);
		overflow-wrap: anywhere;
	}
	.pd-buy {
		margin: 22px 0;
		padding: 20px;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: #fff;
	}
	.pd-price {
		display: flex;
		align-items: baseline;
		gap: 12px;
		flex-wrap: wrap;
		margin-bottom: 14px;
	}
	.pd-price strong {
		font-size: 1.9rem;
	}
	.member {
		color: var(--accent);
	}
	.pd-actions {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
		align-items: center;
	}
	.qty input {
		width: 80px;
		text-align: center;
	}
	.consult-box {
		margin: 22px 0;
		padding: 20px;
		border-radius: var(--radius);
		background: var(--accent-soft);
		border: 1px solid #f6d4c6;
	}
	.consult-box p {
		margin-top: 0;
	}
	.consult-box .btn-ghost {
		background: #fff;
	}
	.pd-desc {
		margin-top: 18px;
		white-space: pre-line;
	}
	.h3 {
		font-size: 1.05rem;
	}
	.pd-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 18px;
	}
	.related {
		margin-top: 52px;
	}
</style>
