---
import Admin from "../../../layouts/Admin.astro";
import { first, run } from "../../../lib/db";
import { slugify } from "../../../lib/markdown";
import { normaliseTags } from "../../../lib/catalog";
import type { Article } from "../../../lib/articles";

const { env } = Astro.locals;
const isNew = Astro.params.id === "new";
let a: Partial<Article> | null = isNew
	? { title_th: "", tags: "", published: 0, published_at: new Date(Date.now() + 7 * 3600e3).toISOString().slice(0, 10) }
	: await first<Article>(env.DB, "SELECT * FROM articles WHERE id = ?", Number(Astro.params.id));
if (!a) return Astro.redirect("/admin/articles");
let error = "";
const msg = Astro.url.searchParams.get("saved") ? "Saved." : "";

if (Astro.request.method === "POST") {
	const fd = await Astro.request.formData();
	if (fd.get("op") === "delete" && !isNew) {
		await run(env.DB, "DELETE FROM articles WHERE id = ?", a.id);
		return Astro.redirect("/admin/articles");
	}
	const g = (k: string, max = 300) => String(fd.get(k) ?? "").trim().slice(0, max);
	const v = {
		title_th: g("title_th"),
		title_en: g("title_en"),
		slug: slugify(g("slug") || g("title_en") || g("title_th")),
		excerpt_th: g("excerpt_th", 600),
		excerpt_en: g("excerpt_en", 600),
		body_th: g("body_th", 60000),
		body_en: g("body_en", 60000),
		cover_media_id: Number(fd.get("cover_media_id")) || null,
		tags: normaliseTags(g("tags")),
		published: fd.get("published") === "on" ? 1 : 0,
		published_at: g("published_at", 10) || null,
	};
	if (!v.title_th) error = "Thai title is required.";
	else if (await first(env.DB, "SELECT id FROM articles WHERE slug = ? AND id != ?", v.slug, isNew ? 0 : a.id)) error = `The web address “${v.slug}” is already used by another article.`;
	if (!error) {
		const cols = Object.keys(v);
		if (isNew) {
			const row = await env.DB.prepare(`INSERT INTO articles (${cols.join(",")}) VALUES (${cols.map(() => "?").join(",")}) RETURNING id`)
				.bind(...Object.values(v))
				.first<{ id: number }>();
			return Astro.redirect(`/admin/articles/${row!.id}?saved=1`);
		}
		await run(env.DB, `UPDATE articles SET ${cols.map((c) => `${c} = ?`).join(", ")}, updated_at = datetime('now') WHERE id = ?`, ...Object.values(v), a.id);
		return Astro.redirect(`/admin/articles/${a.id}?saved=1`);
	}
	a = { ...a, ...v };
}
---

<Admin title={isNew ? "New article" : "Edit article"}>
	<p><a href="/admin/articles">← All articles</a>{!isNew && a.slug && <> · <a href={`/articles/${encodeURIComponent(a.slug)}`} target="_blank">Preview ↗</a></>}</p>
	{msg && <div class="alert alert-ok">{msg}</div>}
	{error && <div class="alert alert-error">{error}</div>}
	<form method="post" class="ed" data-editor>
		<div>
			<section class="card">
				<div class="field"><label for="title_th">Title (Thai) *</label><input id="title_th" name="title_th" required value={a.title_th} /></div>
				<div class="field"><label for="title_en">Title (English)</label><input id="title_en" name="title_en" value={a.title_en ?? ""} /></div>
				<div class="field"><label for="excerpt_th">Short summary (Thai) — shown on the articles list</label><textarea id="excerpt_th" name="excerpt_th" rows="2">{a.excerpt_th ?? ""}</textarea></div>
				<div class="field"><label for="excerpt_en">Short summary (English)</label><textarea id="excerpt_en" name="excerpt_en" rows="2">{a.excerpt_en ?? ""}</textarea></div>
			</section>
			{
				(["th", "en"] as const).map((l) => (
					<section class="card">
						<div class="bar">
							<strong>{l === "th" ? "Article text (Thai)" : "Article text (English)"}</strong>
							<span class="tools" data-tools={`body_${l}`}>
								<button type="button" data-md="## " title="Heading">H</button>
								<button type="button" data-wrap="**" title="Bold"><b>B</b></button>
								<button type="button" data-md="- " title="Bullet list">• List</button>
								<button type="button" data-link title="Link">Link</button>
								<label class="imgbtn" title="Insert picture">Picture<input type="file" accept="image/*" data-insert-img hidden /></label>
							</span>
						</div>
						<textarea id={`body_${l}`} name={`body_${l}`} rows="18" class="body" data-paste-target>{l === "th" ? (a.body_th ?? "") : (a.body_en ?? "")}</textarea>
						<p class="tiny muted">Tip: paste a copied picture straight into the text box. Formatting: <code>## Heading</code>, <code>**bold**</code>, <code>- list item</code>, <code>[link text](https://…)</code>. Don't make health claims about medicines — Thai law restricts drug advertising.</p>
					</section>
				))
			}
		</div>
		<aside>
			<section class="card">
				<label class="check field"><input type="checkbox" name="published" checked={a.published === 1} /> <strong>Published</strong></label>
				<div class="field"><label for="published_at">Date</label><input id="published_at" name="published_at" type="text" placeholder="YYYY-MM-DD" value={a.published_at ?? ""} /></div>
				<div class="field"><label for="slug">Web address</label><input id="slug" name="slug" value={a.slug ?? ""} placeholder="made from the title if empty" /></div>
				<div class="field"><label for="tags">Tags</label><input id="tags" name="tags" value={a.tags ?? ""} placeholder="e.g. cold-flu, kids" /></div>
				<button class="btn btn-block" name="op" value="save">Save</button>
				{!isNew && <button class="btn btn-block btn-ghost del" name="op" value="delete" formnovalidate onclick="return confirm('Delete this article?')">Delete</button>}
			</section>
			<section class="card">
				<strong>Cover picture</strong>
				<input type="hidden" name="cover_media_id" value={a.cover_media_id ?? ""} data-cover-id />
				<div class="cover" data-cover>{a.cover_media_id ? <img src={`/img/m/${a.cover_media_id}`} alt="" /> : <span class="small muted">No cover</span>}</div>
				<div class="paste" tabindex="0" data-cover-paste>Click, then Ctrl+V to paste a picture</div>
				<label class="btn btn-sm btn-ghost" style="cursor:pointer;margin-top:8px">Upload<input type="file" accept="image/*" data-cover-file hidden /></label>
				<button type="button" class="btn btn-sm btn-ghost" data-cover-remove>Remove</button>
				<p class="tiny muted" data-cover-status></p>
			</section>
		</aside>
	</form>
</Admin>

<script>
	import { uploadMedia, imageFromPaste } from "../../../lib/image-client";

	const form = document.querySelector<HTMLFormElement>("[data-editor]")!;
	let lastBody: HTMLTextAreaElement | null = form.querySelector("#body_th");

	function insertAt(ta: HTMLTextAreaElement, text: string) {
		const s = ta.selectionStart ?? ta.value.length;
		const e = ta.selectionEnd ?? s;
		ta.value = ta.value.slice(0, s) + text + ta.value.slice(e);
		ta.selectionStart = ta.selectionEnd = s + text.length;
		ta.focus();
	}
	form.querySelectorAll<HTMLTextAreaElement>("textarea.body").forEach((ta) => ta.addEventListener("focus", () => (lastBody = ta)));

	form.addEventListener("click", (e) => {
		const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-md],[data-wrap],[data-link]");
		if (!b) return;
		const ta = form.querySelector<HTMLTextAreaElement>(`#${b.closest<HTMLElement>("[data-tools]")!.dataset.tools}`)!;
		const sel = ta.value.slice(ta.selectionStart, ta.selectionEnd);
		if (b.dataset.md) insertAt(ta, `\n${b.dataset.md}${sel}`);
		else if (b.dataset.wrap) insertAt(ta, `${b.dataset.wrap}${sel || "text"}${b.dataset.wrap}`);
		else {
			const url = prompt("Link address (https://…)");
			if (url) insertAt(ta, `[${sel || "link text"}](${url})`);
		}
	});

	async function insertImage(ta: HTMLTextAreaElement, blob: Blob) {
		insertAt(ta, "\n(uploading picture…)\n");
		const r = await uploadMedia(blob);
		ta.value = ta.value.replace("(uploading picture…)", r.ok ? `![](${r.url})` : `(upload failed: ${r.error})`);
	}
	form.querySelectorAll<HTMLInputElement>("[data-insert-img]").forEach((inp) =>
		inp.addEventListener("change", () => {
			const ta = form.querySelector<HTMLTextAreaElement>(`#${inp.closest<HTMLElement>("[data-tools]")!.dataset.tools}`)!;
			if (inp.files?.[0]) insertImage(ta, inp.files[0]);
		}),
	);
	form.querySelectorAll<HTMLTextAreaElement>("[data-paste-target]").forEach((ta) =>
		ta.addEventListener("paste", (e) => {
			const file = [...(e.clipboardData?.items ?? [])].find((i) => i.kind === "file" && i.type.startsWith("image/"))?.getAsFile();
			if (file) {
				e.preventDefault();
				insertImage(ta, file);
			}
		}),
	);

	// Cover picture
	const coverId = form.querySelector<HTMLInputElement>("[data-cover-id]")!;
	const coverBox = form.querySelector<HTMLElement>("[data-cover]")!;
	const coverStatus = form.querySelector<HTMLElement>("[data-cover-status]")!;
	async function setCover(blob: Blob) {
		coverStatus.textContent = "Uploading…";
		const r = await uploadMedia(blob);
		if (r.ok) {
			coverId.value = String(r.id);
			coverBox.innerHTML = `<img src="${r.url}" alt="">`;
			coverStatus.textContent = "Done — remember to Save.";
		} else coverStatus.textContent = r.error ?? "Upload failed";
	}
	form.querySelector<HTMLInputElement>("[data-cover-file]")!.addEventListener("change", (e) => {
		const f = (e.target as HTMLInputElement).files?.[0];
		if (f) setCover(f);
	});
	form.querySelector<HTMLElement>("[data-cover-paste]")!.addEventListener("paste", async (e) => {
		e.preventDefault();
		const found = await imageFromPaste(e);
		if (found?.blob) setCover(found.blob);
		else coverStatus.textContent = "Copy a picture first (right-click → Copy image).";
	});
	form.querySelector("[data-cover-remove]")!.addEventListener("click", () => {
		coverId.value = "";
		coverBox.innerHTML = '<span class="small muted">No cover</span>';
	});
	void lastBody;
</script>

<style>
	.ed {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 320px;
		gap: 16px;
		align-items: start;
	}
	@media (max-width: 900px) {
		.ed {
			grid-template-columns: 1fr;
		}
	}
	.bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 10px;
		margin-bottom: 8px;
		flex-wrap: wrap;
	}
	.tools {
		display: flex;
		gap: 4px;
	}
	.tools button,
	.imgbtn {
		border: 1px solid var(--line);
		background: #fff;
		border-radius: 6px;
		padding: 4px 10px;
		font: inherit;
		font-size: 0.85rem;
		cursor: pointer;
		margin: 0;
	}
	.body {
		font-family: ui-monospace, Menlo, Consolas, monospace;
		font-size: 0.92rem;
		line-height: 1.6;
	}
	.cover {
		margin: 10px 0;
		aspect-ratio: 16 / 9;
		border-radius: 10px;
		background: #f1f4f3;
		display: grid;
		place-items: center;
		overflow: hidden;
	}
	.cover :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.paste {
		border: 2px dashed #c9d6d1;
		border-radius: 8px;
		padding: 10px;
		font-size: 0.82rem;
		color: var(--muted);
	}
	.paste:focus {
		border-color: var(--brand);
		outline: none;
		background: var(--brand-soft);
	}
	.del {
		margin-top: 8px;
		color: var(--danger);
	}
</style>
