---
import Admin from "../../layouts/Admin.astro";
import { DEFAULT_SETTINGS, SETTING_KEYS, checkoutEnabled, clearSettingsCache, loadSettings, type Settings } from "../../lib/settings";
import { batchChunks } from "../../lib/db";
import { COUNTRIES, loadZones, type Zone } from "../../lib/shipping";

const { env } = Astro.locals;
let msg = "";
if (Astro.request.method === "POST") {
	const fd = await Astro.request.formData();
	const checkboxes = ["pickup_enabled", "intl_enabled"];
	// Shipping zones table
	if (fd.get("zone_id")) {
		const ids = fd.getAll("zone_id").map(String);
		const zones: Zone[] = ids.map((id, i) => ({
			id,
			name_th: String(fd.getAll("zone_name_th")[i] ?? "").trim(),
			name_en: String(fd.getAll("zone_name_en")[i] ?? "").trim(),
			first_kg: Math.max(0, Number(fd.getAll("zone_first")[i]) || 0),
			extra_kg: Math.max(0, Number(fd.getAll("zone_extra")[i]) || 0),
			days: String(fd.getAll("zone_days")[i] ?? "").trim(),
			countries: String(fd.getAll("zone_countries")[i] ?? "")
				.toUpperCase()
				.split(/[\s,]+/)
				.filter(Boolean),
		}));
		fd.set("intl_zones", JSON.stringify(zones));
	}
	const stmts = SETTING_KEYS.filter((k) => checkboxes.includes(k) || fd.get(k) !== null).map((k) => {
		let v = String(fd.get(k) ?? "").trim().slice(0, k === "intl_zones" ? 8000 : 4000);
		if (checkboxes.includes(k)) v = fd.get(k) === "on" ? "1" : "0";
		if (k.endsWith("_url") && v && !/^https?:\/\//.test(v)) v = `https://${v}`;
		return env.DB.prepare("INSERT INTO settings (key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value").bind(k, v);
	});
	await batchChunks(env.DB, stmts);
	clearSettingsCache();
	msg = "Settings saved.";
}
const s: Settings = Astro.request.method === "POST" ? await loadSettings(env.DB) : Astro.locals.settings;
const zones = loadZones(s);
const usingDefaultRates = !s.intl_zones;

const groups: { title: string; fields: { key: keyof Settings; label: string; hint?: string; type?: string }[] }[] = [
	{
		title: "Links (leave blank to hide)",
		fields: [
			{ key: "line_url", label: "LINE official account link", hint: "e.g. https://lin.ee/xxxx — used for the “Consult our pharmacist” buttons" },
			{ key: "shopee_url", label: "Shopee shop link" },
			{ key: "lazada_url", label: "Lazada shop link" },
			{ key: "facebook_url", label: "Facebook page link" },
			{ key: "wongnai_url", label: "Wongnai page link" },
			{ key: "tiktok_url", label: "TikTok link" },
		],
	},
	{
		title: "Pricing & delivery",
		fields: [
			{ key: "member_discount_pct", label: "Member discount (%)", type: "number" },
			{ key: "shipping_fee", label: "Delivery fee (฿)", type: "number" },
			{ key: "free_shipping_min", label: "Free delivery for orders from (฿, 0 = never)", type: "number" },
		],
	},
	{
		title: "Shop details",
		fields: [
			{ key: "shop_name_th", label: "Shop name (Thai)" },
			{ key: "shop_name_en", label: "Shop name (English)" },
			{ key: "phone", label: "Phone" },
			{ key: "email", label: "Email (optional)" },
			{ key: "address_th", label: "Address (Thai)" },
			{ key: "address_en", label: "Address (English)" },
			{ key: "hours_th", label: "Opening hours (Thai)" },
			{ key: "hours_en", label: "Opening hours (English)" },
			{ key: "map_lat", label: "Map latitude" },
			{ key: "map_lng", label: "Map longitude" },
			{ key: "map_link", label: "Google Maps link" },
		],
	},
	{
		title: "Announcement bar (optional)",
		fields: [
			{ key: "announcement_th", label: "Announcement (Thai)", hint: "Shown at the very top of every page" },
			{ key: "announcement_en", label: "Announcement (English)" },
		],
	},
];
---

<Admin title="Settings">
	{msg && <div class="alert alert-ok">{msg}</div>}
	<form method="post">
		<section class="card">
			<h2 class="h3">Online checkout</h2>
			<div class="field" style="max-width:520px">
				<label for="checkout_mode">How customers buy</label>
				<select id="checkout_mode" name="checkout_mode">
					<option value="auto" selected={s.checkout_mode === "auto"}>Automatic — cart &amp; payment when Opn keys are added, otherwise Shopee/Lazada/LINE</option>
					<option value="on" selected={s.checkout_mode === "on"}>On — cart, checkout and member discount</option>
					<option value="off" selected={s.checkout_mode === "off"}>Off — show Shopee / Lazada / LINE buttons instead of the cart</option>
				</select>
			</div>
			<p class="small muted">Currently: <strong>{checkoutEnabled(s, env) ? "cart & payment ON" : "OFF (Shopee / Lazada / LINE)"}</strong>. When off, the cart, member discount promotions and sign-up links are hidden and online consultation becomes the main call to action. Set each product's own Shopee / Lazada link on its edit page or in the CSV (<code>shopee_url</code>, <code>lazada_url</code>). Controlled medicines always show “Consult pharmacist”.</p>
		</section>
		{
			groups.map((g) => (
				<section class="card">
					<h2 class="h3">{g.title}</h2>
					<div class="grid-2">
						{g.fields.map((f) => (
							<div class="field">
								<label for={f.key}>{f.label}</label>
								<input id={f.key} name={f.key} type={f.type ?? "text"} step={f.type === "number" ? "any" : undefined} value={s[f.key]} placeholder={DEFAULT_SETTINGS[f.key]} />
								{f.hint && <p class="tiny muted">{f.hint}</p>}
							</div>
						))}
					</div>
					{g.title === "Pricing & delivery" && (
						<label class="check small">
							<input type="checkbox" name="pickup_enabled" checked={s.pickup_enabled === "1"} /> Allow “pick up in store” at checkout (free)
						</label>
					)}
				</section>
			))
		}
		<section class="card">
			<h2 class="h3">Overseas shipping</h2>
			<label class="check field"><input type="checkbox" name="intl_enabled" checked={s.intl_enabled === "1"} /> <span><strong>Allow orders to be delivered outside Thailand</strong><br /><span class="small muted">Customers pick their country at checkout. Medicines (OTC and other medication) stay Thailand-only unless you allow a product overseas on its edit page.</span></span></label>
			{usingDefaultRates && <div class="alert alert-warn small">These rates are <strong>examples only</strong>. Replace them with your own quotes (for example Thailand Post EMS World at the post office or thailandpost.co.th) before switching overseas shipping on.</div>}
			<p class="small muted">Fee = first kg + each extra kg (rounded up). Product weight comes from each product's “Shipping weight”; products without one count as 300 g, plus 200 g packaging per parcel. Countries use 2-letter codes; <code>*</code> means every other country.</p>
			<div class="table-scroll">
				<table class="table zones">
					<thead><tr><th>Zone (TH)</th><th>Zone (EN)</th><th>Countries</th><th>First kg ฿</th><th>Each extra kg ฿</th><th>Days</th></tr></thead>
					<tbody>
						{zones.map((z) => (
							<tr>
								<td><input type="hidden" name="zone_id" value={z.id} /><input name="zone_name_th" value={z.name_th} /></td>
								<td><input name="zone_name_en" value={z.name_en} /></td>
								<td><input name="zone_countries" value={z.countries.join(", ")} class="wide" /></td>
								<td><input name="zone_first" value={z.first_kg} inputmode="decimal" class="num" /></td>
								<td><input name="zone_extra" value={z.extra_kg} inputmode="decimal" class="num" /></td>
								<td><input name="zone_days" value={z.days} class="num" /></td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<p class="tiny muted">Country codes: {COUNTRIES.map((c) => `${c.code} ${c.en}`).join(" · ")}</p>
		</section>
		<section class="card">
			<h2 class="h3">Returns &amp; refund policy (optional)</h2>
			<p class="small muted">Leave blank to use the standard policy shown at <a href="/refund-policy" target="_blank">/refund-policy</a>. Opn Payments requires a refund policy that customers accept at checkout.</p>
			<div class="grid-2">
				<div class="field"><label for="refund_policy_th">Thai</label><textarea id="refund_policy_th" name="refund_policy_th" rows="8">{s.refund_policy_th}</textarea></div>
				<div class="field"><label for="refund_policy_en">English</label><textarea id="refund_policy_en" name="refund_policy_en" rows="8">{s.refund_policy_en}</textarea></div>
			</div>
		</section>
		<button class="btn">Save settings</button>
	</form>
	<section class="card" style="margin-top:24px">
		<h2 class="h3">Payments</h2>
		<p class="small">
			Opn Payments: {env.OPN_PUBLIC_KEY && env.OPN_SECRET_KEY ? <strong style="color:var(--ok)">connected{env.OPN_PUBLIC_KEY.startsWith("pkey_test") ? " (TEST mode)" : ""}</strong> : <strong style="color:var(--danger)">not connected</strong>}.
			Keys are set in Cloudflare, not here: <code>OPN_PUBLIC_KEY</code> and <code>OPN_SECRET_KEY</code> as secrets. Webhook URL for the Opn dashboard: <code>{(env.SITE_URL || Astro.url.origin) + "/api/webhooks/opn"}</code>
		</p>
	</section>
</Admin>

<style>
	.zones input {
		min-height: 34px;
		padding: 4px 8px;
	}
	.zones .num {
		width: 90px;
	}
	.zones .wide {
		min-width: 260px;
	}
</style>
