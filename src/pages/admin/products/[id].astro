---
import Admin from "../../../layouts/Admin.astro";
import { CATEGORIES, CATEGORY_SLUGS, allTags, baht, normaliseTags, toSatang, type Product } from "../../../lib/catalog";
import { first, run } from "../../../lib/db";
import { str } from "../../../lib/forms";

const { env } = Astro.locals;
const db = env.DB;
const isNew = Astro.params.id === "new";
let p: Partial<Product> | null = isNew
	? { sku: "", name: "", price_satang: 0, stock: 0, category: "medical_supplies", consult_required: 0, active: 1, featured: 0, tags: "" }
	: await first<Product>(db, "SELECT * FROM products WHERE id = ?", Number(Astro.params.id));
if (!p) return Astro.redirect("/admin/products");

let error = "";
let msg = Astro.url.searchParams.get("saved") ? "Saved." : "";

if (Astro.request.method === "POST") {
	const fd = await Astro.request.formData();
	if (fd.get("op") === "delete" && !isNew) {
		await run(db, "DELETE FROM products WHERE id = ?", p.id);
		return Astro.redirect("/admin/products");
	}
	const v = {
		sku: str(fd, "sku", 64),
		barcode: str(fd, "barcode", 64),
		name: str(fd, "name", 300),
		name_en: str(fd, "name_en", 300),
		unit: str(fd, "unit", 40),
		price_satang: toSatang(str(fd, "price", 20)),
		stock: Math.floor(Number(str(fd, "stock", 10))),
		category: str(fd, "category", 40),
		consult_required: fd.get("consult_required") === "on" ? 1 : 0,
		active: fd.get("active") === "on" ? 1 : 0,
		featured: fd.get("featured") === "on" ? 1 : 0,
		tags: normaliseTags(str(fd, "tags", 500)),
		description: String(fd.get("description") ?? "").trim().slice(0, 4000),
		description_en: String(fd.get("description_en") ?? "").trim().slice(0, 4000),
		manufacturer: str(fd, "manufacturer", 200),
		weight_g: Math.floor(Number(str(fd, "weight_g", 8))) || 0,
		intl_ok: fd.get("intl_ok") === "yes" ? 1 : fd.get("intl_ok") === "no" ? 0 : null,
		shopee_url: str(fd, "shopee_url", 500),
		lazada_url: str(fd, "lazada_url", 500),
	};
	for (const k of ["shopee_url", "lazada_url"] as const) {
		if (v[k] && !/^https?:\/\//.test(v[k])) v[k] = `https://${v[k]}`;
	}

	if (!error) {
		if (!v.sku || !v.name) error = "SKU and name are required.";
		else if (!Number.isFinite(v.price_satang) || v.price_satang < 0) error = "Enter a valid price.";
		else if (!CATEGORY_SLUGS.includes(v.category as never)) error = "Choose a category.";
		else {
			const clash = await first<{ id: number }>(db, "SELECT id FROM products WHERE sku = ? AND id != ?", v.sku, isNew ? 0 : p.id);
			if (clash) error = `SKU ${v.sku} is already used by another product.`;
		}
	}
	if (!error) {
		const stock = Number.isFinite(v.stock) ? v.stock : 0;
		if (isNew) {
			const row = await db
				.prepare(
					`INSERT INTO products (sku, barcode, name, name_en, unit, price_satang, stock, category, consult_required, active, featured, tags, description, description_en, manufacturer, weight_g, intl_ok, shopee_url, lazada_url)
					 VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?) RETURNING id`,
				)
				.bind(v.sku, v.barcode || null, v.name, v.name_en || null, v.unit || null, v.price_satang, stock, v.category, v.consult_required, v.active, v.featured, v.tags, v.description || null, v.description_en || null, v.manufacturer || null, v.weight_g || null, v.intl_ok, v.shopee_url || null, v.lazada_url || null)
				.first<{ id: number }>();
			return Astro.redirect(`/admin/products/${row!.id}?saved=1`);
		}
		await run(
			db,
			`UPDATE products SET sku=?, barcode=?, name=?, name_en=?, unit=?, price_satang=?, stock=?, category=?, consult_required=?, active=?, featured=?, tags=?, description=?, description_en=?, manufacturer=?, weight_g=?, intl_ok=?, shopee_url=?, lazada_url=?, updated_at=datetime('now') WHERE id=?`,
			v.sku,
			v.barcode || null,
			v.name,
			v.name_en || null,
			v.unit || null,
			v.price_satang,
			stock,
			v.category,
			v.consult_required,
			v.active,
			v.featured,
			v.tags,
			v.description || null,
			v.description_en || null,
			v.manufacturer || null,
			v.weight_g || null,
			v.intl_ok,
			v.shopee_url || null,
			v.lazada_url || null,
			p.id,
		);
		return Astro.redirect(`/admin/products/${p.id}?saved=1`);
	}
	p = { ...p, ...v, price_satang: Number.isFinite(v.price_satang) ? v.price_satang : 0 };
}
const tags = await allTags(db, true);
---

<Admin title={isNew ? "New product" : p.name ?? "Product"}>
	<p><a href="/admin/products">← All products</a>{!isNew && p.active ? <> · <a href={`/products/${encodeURIComponent(p.sku ?? "")}`} target="_blank">View on site ↗</a></> : null}</p>
	{msg && <div class="alert alert-ok">{msg}</div>}
	{error && <div class="alert alert-error">{error}</div>}
	<form method="post" class="edit">
		<div class="card">
			<div class="grid-2">
				<div class="field"><label for="sku">SKU (product code) *</label><input id="sku" name="sku" required value={p.sku} /></div>
				<div class="field"><label for="barcode">Barcode</label><input id="barcode" name="barcode" value={p.barcode ?? ""} /></div>
			</div>
			<div class="field"><label for="name">Name (as shown on the site) *</label><input id="name" name="name" required value={p.name} /></div>
			<div class="field"><label for="name_en">English name (optional — shown when the site is in English)</label><input id="name_en" name="name_en" value={p.name_en ?? ""} /></div>
			<div class="grid-2">
				<div class="field"><label for="price">Selling price (฿) *</label><input id="price" name="price" inputmode="decimal" required value={((p.price_satang ?? 0) / 100).toString()} /></div>
				<div class="field"><label for="stock">Stock</label><input id="stock" name="stock" inputmode="numeric" value={p.stock ?? 0} /></div>
				<div class="field"><label for="unit">Unit (box, bottle, strip…)</label><input id="unit" name="unit" value={p.unit ?? ""} /></div>
				<div class="field">
					<label for="category">Category *</label>
					<select id="category" name="category">
						{CATEGORIES.map((c) => <option value={c.slug} selected={p.category === c.slug}>{c.en} · {c.th}</option>)}
					</select>
				</div>
			</div>
			<div class="field"><label for="tags">Tags (comma separated)</label><input id="tags" name="tags" value={p.tags ?? ""} list="taglist" /><datalist id="taglist">{tags.map((tg) => <option value={tg.tag} />)}</datalist>
				<p class="tiny muted">Existing tags: {tags.map((tg) => tg.tag).join(", ")}</p></div>
			<div class="field"><label for="manufacturer">Manufacturer / brand</label><input id="manufacturer" name="manufacturer" value={p.manufacturer ?? ""} /></div>
			<div class="field"><label for="description">Description (Thai)</label><textarea id="description" name="description" rows="4">{p.description ?? ""}</textarea></div>
			<div class="field"><label for="description_en">Description (English)</label><textarea id="description_en" name="description_en" rows="4">{p.description_en ?? ""}</textarea></div>
			<div class="grid-2">
				<div class="field"><label for="shopee_url"><img src="/social/shopee.svg" alt="" width="14" height="14" /> Shopee product link</label><input id="shopee_url" name="shopee_url" value={p.shopee_url ?? ""} placeholder="https://shopee.co.th/…" /></div>
				<div class="field"><label for="lazada_url">Lazada product link</label><input id="lazada_url" name="lazada_url" value={p.lazada_url ?? ""} placeholder="https://www.lazada.co.th/products/…" /></div>
			</div>
			<p class="tiny muted" style="margin-top:-6px">Shown as Shopee / Lazada buttons when online checkout is off. Controlled medicines show “Consult pharmacist” instead.</p>
			<div class="grid-2">
				<div class="field"><label for="weight_g">Shipping weight (grams)</label><input id="weight_g" name="weight_g" inputmode="numeric" value={p.weight_g ?? ""} placeholder="300 if blank" /></div>
				<div class="field">
					<label for="intl_ok">Ship overseas?</label>
					<select id="intl_ok" name="intl_ok">
						<option value="" selected={p.intl_ok === null || p.intl_ok === undefined}>Default (supplies &amp; supplements only)</option>
						<option value="yes" selected={p.intl_ok === 1}>Yes</option>
						<option value="no" selected={p.intl_ok === 0}>No — Thailand only</option>
					</select>
				</div>
			</div>
		</div>
		<div>
			<div class="card">
				<label class="check field"><input type="checkbox" name="active" checked={p.active === 1} /> <span><strong>Show on website</strong></span></label>
				<label class="check field"><input type="checkbox" name="consult_required" checked={p.consult_required === 1} /> <span><strong>Requires pharmacist consultation</strong><br /><span class="small muted">Listed on the site, but can't be added to the cart.</span></span></label>
				<label class="check field"><input type="checkbox" name="featured" checked={p.featured === 1} /> <span><strong>Feature on home page</strong></span></label>
				{!isNew && <p class="small muted">Current price: {baht(p.price_satang ?? 0)} · Updated {p.updated_at}</p>}
			</div>
			<button class="btn btn-block" type="submit" name="op" value="save">Save product</button>
			{!isNew && <button class="btn btn-block btn-ghost del" type="submit" name="op" value="delete" formnovalidate onclick="return confirm('Delete this product permanently?')">Delete product</button>}
		</div>
	</form>
	{
		!isNew && (
			<section class="card photo" data-photo data-pid={p.id}>
				<strong>Photo</strong>
				<div class="ph" data-thumb>{p.image_url ? <img src={p.image_url} alt="" /> : <span class="small muted">No photo yet</span>}</div>
				<div class="paste" tabindex="0" data-paste>Click here, then press Ctrl+V to paste a copied image or image link</div>
				<div class="row-actions">
					<label class="btn btn-sm btn-ghost" style="cursor:pointer">Upload file<input type="file" accept="image/*" data-file hidden /></label>
					<a class="btn btn-sm btn-ghost" target="_blank" rel="noopener" href={`https://www.google.com/search?tbm=isch&q=${encodeURIComponent(`${p.name} ${p.manufacturer ?? ""}`.trim())}`}>Search Google Images</a>
					{p.barcode && <button type="button" class="btn btn-sm btn-ghost" data-off>Auto-find by barcode</button>}
					<button type="button" class="btn btn-sm btn-ghost" data-del>Remove photo</button>
				</div>
				<div class="small" data-status></div>
			</section>
		)
	}
</Admin>

<script>
	import { uploadImage, imageFromUrl, imageFromPaste, openFacts, deleteImage, type UploadResult } from "../../../lib/image-client";
	const box = document.querySelector<HTMLElement>("[data-photo]");
	if (box) {
		const pid = Number(box.dataset.pid);
		const status = box.querySelector<HTMLElement>("[data-status]")!;
		const show = (r: UploadResult) => {
			if (r.ok) {
				box.querySelector<HTMLElement>("[data-thumb]")!.innerHTML = r.image_url ? `<img src="${r.image_url}" alt="">` : `<span class="small muted">No photo yet</span>`;
				status.textContent = r.image_url ? "Saved ✓" : "Removed";
			} else status.textContent = r.error ?? "Failed";
		};
		box.querySelector<HTMLInputElement>("[data-file]")!.addEventListener("change", async (e) => {
			const f = (e.target as HTMLInputElement).files?.[0];
			if (f) {
				status.textContent = "Uploading…";
				show(await uploadImage(f, { productId: pid }));
			}
		});
		box.querySelector("[data-off]")?.addEventListener("click", async () => {
			status.textContent = "Looking up…";
			show(await openFacts(pid));
		});
		box.querySelector("[data-del]")!.addEventListener("click", async () => show(await deleteImage(pid)));
		box.querySelector<HTMLElement>("[data-paste]")!.addEventListener("paste", async (e) => {
			e.preventDefault();
			const found = await imageFromPaste(e);
			if (!found) return (status.textContent = "Nothing to paste — copy an image first.");
			status.textContent = "Saving…";
			show(found.blob ? await uploadImage(found.blob, { productId: pid }) : await imageFromUrl(pid, found.url!));
		});
	}
</script>

<style>
	.edit {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
		gap: 16px;
		align-items: start;
	}
	@media (max-width: 900px) {
		.edit {
			grid-template-columns: 1fr;
		}
	}
	.photo {
		max-width: 560px;
	}
	.ph {
		margin: 10px 0;
		width: 200px;
		height: 200px;
		border-radius: 10px;
		background: #f1f4f3;
		display: grid;
		place-items: center;
		overflow: hidden;
	}
	.ph :global(img) {
		width: 100%;
		height: 100%;
		object-fit: contain;
		background: #fff;
	}
	.paste {
		border: 2px dashed #c9d6d1;
		border-radius: 8px;
		padding: 12px;
		font-size: 0.85rem;
		color: var(--muted);
		background: #f7f9f8;
	}
	.paste:focus {
		border-color: var(--brand);
		background: var(--brand-soft);
		outline: none;
	}
	.row-actions {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
		margin: 10px 0 6px;
	}
	.del {
		margin-top: 10px;
		color: var(--danger);
	}
</style>
